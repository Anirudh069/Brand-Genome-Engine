# Copy this file to .env and fill in real values. Never commit .env.

# --- Rewrite provider (OpenAI) ---------------------------------------------
# Leave OPENAI_API_KEY unset/empty to run with the local fallback rewrite
# provider (no external calls); the rest of the app works fully without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Explicit override; defaults to "openai" if OPENAI_API_KEY is set, else "fallback".
REWRITE_PROVIDER=openai
LLM_TIMEOUT_SECONDS=30

# --- Backend runtime config --------------------------------------------------
SQLITE_DB_PATH=data/brand_data.db
CORS_ORIGIN=http://localhost:5173
ANALYTICS_CACHE_PATH=data/processed/analytics_cache.json
RAG_INDEX_DIR=data/processed/rag
